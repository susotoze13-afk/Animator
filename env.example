# the command line's key; the web API uses each user's own key instead
GEMINI_API_KEY=
# optional: override the default text model
# GEMINI_MODEL=

# backend for --prompt: gemini, openrouter or opencode
# auto-detected: OpenRouter when OPENROUTER_API_KEY is set, else Gemini when a
# Google key is set, else opencode (which needs no key here)
# ANIMATOR_BACKEND=opencode

# OpenRouter: the whole --prompt pipeline can run on this key instead of a Google one
# (https://openrouter.ai/keys). List usable models: python -m animator.openrouter.discover
OPENROUTER_API_KEY=
# optional model overrides (OpenRouter slugs)
# OPENROUTER_TEXT_MODEL=google/gemini-3.8-flash
# OPENROUTER_REGION_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# OPENROUTER_TTS_MODEL=google/gemini-2.5-flash-preview-tts
# OPENROUTER_VOICE=Kore

# opencode backend: runs the pipeline on services your OpenCode already has, so no
# Google/OpenRouter key is needed. Text+vision+images use Pollinations (the same
# service and key as OpenCode's image tool); narration uses the OS text-to-speech
# (Windows SAPI). The key is read from POLLINATIONS_API_KEY, or from OpenCode's
# ~/.config/opencode/pollinations-shim/token.txt when unset.
#
# NOTE: the keyed Pollinations models (text/vision/images) spend "pollen". With a
# zero balance the backend falls back to the free anonymous endpoints: text still
# works (storyboard), but vision is unavailable (frames draw sequentially) and the
# free image model is rate-limited (about 1 image / 45 s) and much lower quality.
# For proper whiteboard frames, top up at https://enter.pollinations.ai/top-up.
# POLLINATIONS_API_KEY=
# OPENCODE_TEXT_MODEL=openai
# OPENCODE_REGION_MODEL=openai
# POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1.1-pro
# free fallback model (legacy endpoint; "flux" follows the whiteboard style best)
# POLLINATIONS_FREE_MODEL=flux
# free text endpoint used when the keyed one is out of pollen
# POLLINATIONS_TEXT_URL=https://text.pollinations.ai/openai
# OPENCODE_SAPI_VOICE=Microsoft Zira Desktop   (or "Microsoft Irina Desktop" for RU)

# web API (python -m animator.api)
# Supabase project settings -> API keys. Use the SECRET key here (server only, never in the frontend).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# comma-separated frontend origins allowed to call the API
API_ALLOWED_ORIGINS=http://localhost:5173

# production (docker-compose.prod.yml): the domain Caddy serves over HTTPS
# DOMAIN=clipkatha.com
